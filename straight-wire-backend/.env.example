PORT=8081
NODE_ENV=development
APP_BASE_URL=http://127.0.0.1:8081
CORS_ALLOWED_ORIGINS=
CSRF_ALLOWED_ORIGINS=
LOG_FORMAT=pretty

GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.local.json
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-firebase-web-api-key

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_URL=cloudinary://your-cloudinary-api-key:your-cloudinary-api-secret@your-cloudinary-cloud-name
CLOUDINARY_AUTH_TOKEN_KEY=your-cloudinary-auth-token-key

WHATSAPP_TRANSPORT=noop
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
WHATSAPP_INTERNAL_WEBHOOK_MODE=log

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_STATUS_CALLBACK_URL=

TELEGRAM_TRANSPORT=disabled
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
