{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@electric/builder-domain": [
        "packages/builder-domain/src/index.ts"
      ],
      "@electric/estimator-core": [
        "packages/estimator-core/src/index.ts"
      ],
      "@electric/mobile-types": [
        "apps/mobile/src/types/api.ts"
      ]
    }
  }
}
