{
  "expo": {
    "name": "Electric Staff",
    "slug": "electric-staff",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "electricstaff",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.straightwireelectric.staff",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Electric Staff usa tu ubicacion para registrar llegada e inicio de trabajo.",
        "NSCameraUsageDescription": "Electric Staff necesita acceso a la camara para selfies y evidencia.",
        "NSPhotoLibraryUsageDescription": "Electric Staff necesita acceso a fotos para subir pruebas y evidencia.",
        "NSMicrophoneUsageDescription": "Electric Staff necesita acceso al microfono para grabaciones de evidencia.",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "package": "com.straightwireelectric.staff"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "color": "#1A73E8"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Electric Staff usa tu ubicacion para registrar llegada e inicio de trabajo."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Electric Staff necesita acceso a fotos para subir pruebas y evidencia.",
          "cameraPermission": "Electric Staff necesita acceso a la camara para selfies y evidencia."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Electric Staff necesita acceso a la camara para selfies y evidencia."
        }
      ],
      "expo-sharing",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "electric-staff",
          "organization": "straightwireelectric"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
