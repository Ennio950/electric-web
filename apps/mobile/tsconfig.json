{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "customConditions": [
      "react-native"
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@electric/builder-domain": [
        "../../packages/builder-domain/src/index.ts"
      ],
      "@electric/estimator-core": [
        "../../packages/estimator-core/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
